# Copy this whole file into Streamlit Cloud → your app → Settings → Secrets.
# For local runs, save it as .streamlit/secrets.toml (git-ignored — never commit it).

# ── Who may use the dashboard (anyone else is refused after Google sign-in) ──
ALLOWED_EMAILS = ["you@example.com", "teammate@example.com"]

# ── Supabase ──
SUPABASE_URL = "https://hoihnpzdlivaoywrshmk.supabase.co"
SUPABASE_KEY = "your-anon-key"
# Optional but recommended: server-only key. When set it is used instead of SUPABASE_KEY,
# which lets you restrict the public anon key to read-only with RLS.
# SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"

# ── ImageKit (use a NEW private key — the old one is public in git history) ──
IMAGEKIT_PRIVATE_KEY = "private_xxx"
IMAGEKIT_PUBLIC_KEY = "public_xxx"

# ── GATE DB editor password (choose a new one) ──
ADMIN_PASSWORD = "a-long-new-password"

# ── Firebase (Web API key: Firebase console → Project settings → General) ──
FIREBASE_WEB_API_KEY = "AIza..."
# FIREBASE_PROJECT_ID = "mvp-dashboard-c56c0"

# ── Google sign-in (Google Cloud console → project mvp-dashboard-c56c0 →
#    APIs & Services → Credentials → Create OAuth client ID → "Web application") ──
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"   # local: http://localhost:8501/oauth2callback
cookie_secret = "run: python -c \"import secrets; print(secrets.token_urlsafe(48))\""
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = ["id"]
