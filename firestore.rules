rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dashboard admins — keep in sync with the ADMIN_EMAILS secret of the web app.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['otherp1234@gmail.com'];
    }

    // Web dashboard access requests, one per Firebase user (doc id = uid).
    // Users can only file a *pending* request for themselves; only admins decide.
    match /dashboard_access/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'note', 'status', 'requested_at'])
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.status == 'pending'
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 500;
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin()
                    && request.resource.data.status in ['approved', 'rejected', 'revoked']
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email;
      allow delete: if isAdmin();
    }

    // Allow public read access to info_guides (help docs & schemas)
    match /info_guides/{document} {
      allow read: if true;
    }

    // Allow authenticated users to read/write their own user doc and todos
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /todos/{todoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Flat to-do collection used by the desktop + web apps: owners only.
    // (The web app queries with `where user_id == uid`, which these rules require.)
    match /todos/{todoId} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow read, delete: if request.auth != null
                          && resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == request.auth.uid;
    }

    // Allow authenticated users to write to activity_logs
    match /activity_logs/{document} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // only admin/service account can read/modify logs
    }

    // Allow authenticated users to read/write spotify_settings
    match /spotify_settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
